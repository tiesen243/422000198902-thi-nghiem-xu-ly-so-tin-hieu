#include <stdio.h>
#include <math.h>          // Standard C output library
#include "dsk6416_aic23.h" // support file for codec,DSK

Uint32 fs = DSK6416_AIC23_FREQ_16KHZ; // set sampling rate
// Prototypes
void blockSine(short *buf, int len);

// Declarations
#define BUFFSIZE 128

// Global Variables
short gBuffer[BUFFSIZE];

//  ======== main ========
//  Simple function which calls blockSine
void main()
{
    Uint32 tick_ms = 0;
    int led3_state = 0;

    c6416_dsk_init();
    DSK6416_LED_init(); // init LED from BSL
    DSK6416_DIP_init(); // init DIP from BSL

    printf("dsp lab2\n");
    blockSine(gBuffer, BUFFSIZE); // Fill buffer with sine data
    printf("Bo nho gBuffer (o dia chi %d) duoc dien voi du lieu  Sin\n",
           gBuffer);

    while (1)
    {
        if (DSK6416_DIP_get(0) == 0) // =0 if DIP switch #0 pressed
            DSK6416_LED_on(2);       // turn LED #2 ON
        else
            DSK6416_LED_off(2); // turn LED #2 OFF

        if (tick_ms >= 2000)
        {
            DSK6416_LED_toggle(3);
            tick_ms = 0;
        }

        DSK6416_waitusec(10000); // 10 ms tick
        tick_ms += 10;
    }
}
