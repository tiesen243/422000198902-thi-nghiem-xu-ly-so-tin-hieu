    // tạo bản nhạc Do 256hz Re 288hz Mi 324hz Fa 342hz Sol 384hz La 432hz Si 484hz
    const float wDo = (2.0f * (float)PI * 256.0f) / 48000.0f;
    const float wRe = (2.0f * (float)PI * 288.0f) / 48000.0f;
    const float wMi = (2.0f * (float)PI * 324.0f) / 48000.0f;
    const float wFa = (2.0f * (float)PI * 342.0f) / 48000.0f;
    const float wSol = (2.0f * (float)PI * 384.0f) / 48000.0f;
    const float wLa = (2.0f * (float)PI * 432.0f) / 48000.0f;
    const float wSi = (2.0f * (float)PI * 484.0f) / 48000.0f;
    float phaseDo = 0.0f;
    float phaseRe = 0.0f;
    float phaseMi = 0.0f;
    float phaseFa = 0.0f;
    float phaseSol = 0.0f;
    float phaseLa = 0.0f;
    float phaseSi = 0.0f;

    const int samplesPerNote = 48000;
    int noteIndex = 0;
    int sampleCount = 0;

    while (1)
    {
        // Do -> hold 1s -> Re -> hold 1s -> Mi -> hold 1s -> Fa -> hold 1s -> Sol -> hold 1s -> La -> hold 1s -> Si -> hold 1s -> loop
        float sampleFloat = 0.0f;

        if (noteIndex == 0)
        {
            sampleFloat = sinf(phaseDo);
            phaseDo += wDo;
            if (phaseDo >= 2.0f * (float)PI)
                phaseDo -= 2.0f * (float)PI;
        }
        else if (noteIndex == 1)
        {
            sampleFloat = sinf(phaseRe);
            phaseRe += wRe;
            if (phaseRe >= 2.0f * (float)PI)
                phaseRe -= 2.0f * (float)PI;
        }
        else if (noteIndex == 2)
        {
            sampleFloat = sinf(phaseMi);
            phaseMi += wMi;
            if (phaseMi >= 2.0f * (float)PI)
                phaseMi -= 2.0f * (float)PI;
        }
        else if (noteIndex == 3)
        {
            sampleFloat = sinf(phaseFa);
            phaseFa += wFa;
            if (phaseFa >= 2.0f * (float)PI)
                phaseFa -= 2.0f * (float)PI;
        }
        else if (noteIndex == 4)
        {
            sampleFloat = sinf(phaseSol);
            phaseSol += wSol;
            if (phaseSol >= 2.0f * (float)PI)
                phaseSol -= 2.0f * (float)PI;
        }
        else if (noteIndex == 5)
        {
            sampleFloat = sinf(phaseLa);
            phaseLa += wLa;
            if (phaseLa >= 2.0f * (float)PI)
                phaseLa -= 2.0f * (float)PI;
        }
        else
        {
            sampleFloat = sinf(phaseSi);
            phaseSi += wSi;
            if (phaseSi >= 2.0f * (float)PI)
                phaseSi -= 2.0f * (float)PI;
        }

        output_left_sample((short)(12000.0f * sampleFloat));

        sampleCount++;
        if (sampleCount >= samplesPerNote)
        {
            sampleCount = 0;
            noteIndex++;
            if (noteIndex >= 7)
                noteIndex = 0;
        }
    }
